# Template only — copy to .env and fill in your real keys there.
# (.env is gitignored; this file is safe to commit/share.)

# ── Supabase (Settings → API) ────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role secret — NEVER put in the React app

# ── Qdrant Cloud (cloud.qdrant.io → cluster → API key) ───────
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=...
QDRANT_COLLECTION=iskolarchat_chunks

# ── Cohere Embed v3 (dashboard.cohere.com) ───────────────────
COHERE_API_KEY=...
EMBED_MODEL=embed-english-v3.0
EMBED_DIM=1024

# ── LLM: any OpenAI-compatible endpoint ──────────────────────
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=deepseek/deepseek-v4-flash

# Cheaper/faster model for decomposition + relevance grading
GRADER_MODEL=deepseek/deepseek-v4-flash

# Vision model for student-attached images (document OCR)
VISION_MODEL=qwen/qwen3-vl-8b-instruct

# ── Moondream image captioning (optional — skipped when empty)
#MOONDREAM_API_KEY=...

# ── Retrieval tuning (defaults shown) ────────────────────────
#CHUNK_SIZE_WORDS=350
#CHUNK_OVERLAP_WORDS=80
#SEARCH_TOP_N=10
#RRF_K=60
#FINAL_TOP_K=8
#RELEVANCE_THRESHOLD=0.5
#MIN_RELEVANT_CHUNKS=1

CORS_ORIGINS=http://localhost:5173
